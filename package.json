{
  "name": "monorepo-ssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/pocketbase\"",
    "dev:celular": "concurrently --kill-others --raw \"npm run dev:celular --prefix apps/web\" \"npm run dev --prefix apps/pocketbase\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "node server.mjs",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "typecheck": "concurrently --raw \"npm run typecheck --prefix apps/web\""
  },
  "dependencies": {
    "@react-router/express": "^8.3.0",
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
